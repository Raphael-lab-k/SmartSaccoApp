<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.KycFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_kyc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_complete_profile"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_kyc_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/desc_kyc_verification"
            android:textColor="@color/text_light"
            app:layout_constraintTop_toBottomOf="@id/text_kyc_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_id_number"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/label_id_number"
            app:layout_constraintTop_toBottomOf="@id/text_kyc_subtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_id_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_address"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/label_address"
            app:layout_constraintTop_toBottomOf="@id/til_id_number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_branch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/label_select_branch"
            app:layout_constraintTop_toBottomOf="@id/til_address">

            <AutoCompleteTextView
                android:id="@+id/dropdown_branch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_select_branch"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_kyc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_submit_verification"
            app:layout_constraintTop_toBottomOf="@id/til_branch"
            app:cornerRadius="8dp" />

        <ProgressBar
            android:id="@+id/progress_kyc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_submit_kyc"
            app:layout_constraintEnd_toEndOf="@id/btn_submit_kyc"
            app:layout_constraintStart_toStartOf="@id/btn_submit_kyc"
            app:layout_constraintTop_toTopOf="@id/btn_submit_kyc" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>